msgid "plugins.generic.academiaEdu.article.note"
msgstr "This only prepares the data. Nothing is sent to Academia.edu automatically; the author uploads the work from their own account and must hold the rights to share the file."

msgid "plugins.generic.academiaEdu.report.oaiTitle"
msgstr "OAI-PMH endpoint"

msgid "plugins.generic.academiaEdu.report.oaiOn"
msgstr "OAI-PMH is enabled"

msgid "plugins.generic.academiaEdu.report.oaiOff"
msgstr "OAI-PMH is disabled in config.inc.php ([oai] oai = On is required)"

msgid "plugins.generic.academiaEdu.report.oaiTest"
msgstr "Test endpoint (Identify)"

msgid "plugins.generic.academiaEdu.report.oaiOk"
msgstr "✓ Endpoint responded correctly"

msgid "plugins.generic.academiaEdu.report.oaiFail"
msgstr "✗ No valid OAI-PMH response"

msgid "plugins.generic.academiaEdu.report.oaiHelp"
msgstr "OJS already exposes this endpoint. Register its URL with harvesters such as BASE, CORE or OpenAIRE so they collect your records automatically. Academia.edu does not document OAI-PMH harvesting, so this plugin does not claim that it will."

