msgid "plugins.generic.academiaEdu.displayName"
msgstr "Academia.edu Integration"

msgid "plugins.generic.academiaEdu.description"
msgstr "Metadata, upload package and OAI-PMH tools for sharing OJS 3.5 articles on Academia.edu and indexing services."

msgid "plugins.generic.academiaEdu.action.report"
msgstr "Metadata & OAI report"

msgid "plugins.generic.academiaEdu.settings.intro"
msgstr "This plugin prepares published articles for Academia.edu and indexers. It does not store Academia.edu credentials or automate login."

msgid "plugins.generic.academiaEdu.settings.buttonLabel"
msgstr "Article-page panel label"

msgid "plugins.generic.academiaEdu.settings.panelVisibility"
msgstr "Who sees the upload-package panel on article pages"

msgid "plugins.generic.academiaEdu.settings.visibility.public"
msgstr "Everyone"

msgid "plugins.generic.academiaEdu.settings.visibility.loggedIn"
msgstr "Logged-in users only"

msgid "plugins.generic.academiaEdu.settings.visibility.hidden"
msgstr "Nobody (metadata tags only)"

msgid "plugins.generic.academiaEdu.settings.showMetaTags"
msgstr "Add Open Graph and citation meta tags (citation tags are skipped if the Google Scholar plugin is enabled)"

msgid "plugins.generic.academiaEdu.settings.showJsonLd"
msgstr "Add JSON-LD ScholarlyArticle metadata"

msgid "plugins.generic.academiaEdu.settings.showDublinCore"
msgstr "Add Dublin Core metadata (skipped if the Dublin Core plugin is enabled)"

msgid "plugins.generic.academiaEdu.settings.addOaiLink"
msgstr "Add per-article OAI-PMH record link in the page head"

msgid "plugins.generic.academiaEdu.settings.showBibtex"
msgstr "Offer downloadable BibTeX"

msgid "plugins.generic.academiaEdu.settings.showRis"
msgstr "Offer downloadable RIS"

